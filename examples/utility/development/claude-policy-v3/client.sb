(version 1)
(deny default)
(deny process-info*)
(allow process-info* (target self))
(allow sysctl-read (sysctl-name-prefix "hw.") (sysctl-name "kern.osrelease") (sysctl-name "kern.osversion") (sysctl-name "kern.ostype") (sysctl-name "kern.osproductversion"))
(allow process-fork)
(allow process-exec (literal "/Users/cam/.local/share/claude/versions/2.1.310") (literal "/private/tmp/claude-policy-probe-v3/auth/helper") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs/default/bin/python3.12"))
(allow file-read* (subpath "/private/tmp/claude-policy-probe-v3/workspace") (subpath "/private/tmp/claude-policy-probe-v3/home") (subpath "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs/default") (subpath "/usr/lib") (subpath "/System/Library") (subpath "/usr/share/icu") (literal "/Users/cam/.local/share/claude/versions/2.1.310") (literal "/private/tmp/claude-policy-probe-v3/auth/helper") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs/default/bin/python3.12") (literal "/private/tmp/claude-policy-probe-v3/auth/key.txt") (literal "/") (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom") (literal "/etc") (literal "/private/etc/ssl/openssl.cnf"))
(allow file-read-metadata (literal "/") (literal "/System") (literal "/Users") (literal "/Users/cam") (literal "/Users/cam/.local") (literal "/Users/cam/.local/share") (literal "/Users/cam/.local/share/claude") (literal "/Users/cam/.local/share/claude/versions") (literal "/Users/cam/Library") (literal "/Users/cam/Library/Caches") (literal "/Users/cam/Library/Caches/rattler") (literal "/Users/cam/Library/Caches/rattler/cache") (literal "/Users/cam/Library/Caches/rattler/cache/envs") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs/default") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs/default/bin") (literal "/dev") (literal "/private") (literal "/private/etc") (literal "/private/etc/ssl") (literal "/private/tmp") (literal "/private/tmp/claude-policy-probe-v3") (literal "/private/tmp/claude-policy-probe-v3/auth") (literal "/usr") (literal "/usr/share"))
(allow file-write* (subpath "/private/tmp/claude-policy-probe-v3/home") (literal "/dev/null"))
(allow network-outbound (remote ip "localhost:49182"))
