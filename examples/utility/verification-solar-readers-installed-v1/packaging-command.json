{
  "build": {
    "entrypoint": "setuptools.build_meta.build_wheel",
    "cwd": "copied staged source directory",
    "inputs": "input-pins.json",
    "acquisition": false,
    "build_log": "build-correct.log"
  },
  "install": {
    "command": "python -m pip --isolated --disable-pip-version-check install --no-index --no-deps --no-compile --no-cache-dir --target TARGET_SITE CORRECTED_WHEEL",
    "exit_code": 0,
    "log": "install.log"
  },
  "cold": {
    "script": "installed-reader.py.txt",
    "command": "python -I -B installed-reader.py TARGET_SITE RELOCATED_AUTHORED_BUNDLES",
    "terminal_repeat_exit_code": 0,
    "log": "cold-terminal.log"
  }
}
