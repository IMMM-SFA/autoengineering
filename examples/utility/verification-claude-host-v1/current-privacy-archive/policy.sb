(version 1)
(deny default)
(deny process-info*)
(allow process-info* (target self))
(allow sysctl-read (sysctl-name-prefix "hw.") (sysctl-name "kern.osrelease") (sysctl-name "kern.osversion") (sysctl-name "kern.ostype") (sysctl-name "kern.osproductversion"))
(allow process-fork)
(allow process-exec (literal "/private/tmp/claude-host-source-probes-v1/privacy/probe") (literal "/private/tmp/claude-host-source-probes-v1/privacy/trusted-helper") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs/default/bin/python3.12") (literal "/bin/sh") (literal "/bin/bash"))
(allow file-read* (subpath "/private/tmp/claude-host-source-probes-v1/privacy/workspace") (subpath "/private/tmp/claude-host-source-probes-v1/privacy/home") (subpath "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs/default") (subpath "/usr/lib") (subpath "/System/Library") (subpath "/usr/share/icu") (literal "/private/tmp/claude-host-source-probes-v1/privacy/probe") (literal "/private/tmp/claude-host-source-probes-v1/privacy/trusted-helper") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs/default/bin/python3.12") (literal "/bin/sh") (literal "/bin/bash") (literal "/private/var/select/sh") (literal "/") (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom") (literal "/etc") (literal "/private/etc/ssl/openssl.cnf"))
(allow file-read-metadata (literal "/") (literal "/System") (literal "/Users") (literal "/Users/cam") (literal "/Users/cam/Library") (literal "/Users/cam/Library/Caches") (literal "/Users/cam/Library/Caches/rattler") (literal "/Users/cam/Library/Caches/rattler/cache") (literal "/Users/cam/Library/Caches/rattler/cache/envs") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs/default") (literal "/Users/cam/Library/Caches/rattler/cache/envs/autoengineering-2706574624935427595/envs/default/bin") (literal "/bin") (literal "/dev") (literal "/private") (literal "/private/etc") (literal "/private/etc/ssl") (literal "/private/tmp") (literal "/private/tmp/claude-host-source-probes-v1") (literal "/private/tmp/claude-host-source-probes-v1/privacy") (literal "/private/var") (literal "/private/var/select") (literal "/usr") (literal "/usr/share"))
(allow file-write* (subpath "/private/tmp/claude-host-source-probes-v1/privacy/home") (literal "/dev/null"))
(allow network-outbound (remote ip "localhost:62118"))
